# Google Maps key: Places (search) + Geocoding (“Use current” GPS → city).
# Copy to `.env` (gitignored). Enable Places API + Geocoding API; restrict to your app bundle IDs.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Sentry crash reporting. JS errors report when DSN is set.
# Native source maps upload on EAS only if SENTRY_ORG + SENTRY_PROJECT + SENTRY_AUTH_TOKEN are also set.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
