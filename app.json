{
  "expo": {
    "name": "R/HOOD",
    "slug": "rhoodapp",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "assets/rhood_logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*",
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rhoodapp.mobile",
      "newArchEnabled": true,
      "usesAppleSignIn": true,
      "googleServicesFile": "./ios/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": [
          "audio"
        ],
        "NSPhotoLibraryAddUsageDescription": "R/HOOD may save images you choose, such as mix artwork, to your photo library only if you ask us to.",
        "NSCameraUsageDescription": "R/HOOD uses the camera so you can take a profile photo, add photos to messages, and attach images to gig applications.",
        "NSPhotoLibraryUsageDescription": "R/HOOD accesses your photos so you can set a profile picture, share images in messages, and attach photos to playlists and applications.",
        "NSMicrophoneUsageDescription": "R/HOOD uses the microphone if you record audio for messages or mixes.",
        "NSUserNotificationsUsageDescription": "R/HOOD sends notifications for messages, gig applications, connections, and lock-screen playback controls.",
        "NSLocationWhenInUseUsageDescription": "R/HOOD uses your location while the app is open to match you with DJs and opportunities in the same city.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "rhoodapp",
            "CFBundleURLSchemes": [
              "rhoodapp",
              "rhood"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "mailto",
          "whatsapp",
          "sms",
          "instagram"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "assets/rhood_logo.png",
        "backgroundColor": "#000000"
      },
      "package": "com.rhoodapp.mobile",
      "googleServicesFile": "./android/app/google-services.json",
      "newArchEnabled": true,
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "notification": {
      "icon": "assets/rhood_logo.png",
      "color": "#ffffff"
    },
    "extra": {
      "eas": {
        "projectId": "499f2244-43f3-478d-8b88-85c2da9f1d52"
      },
      "aiChatTransport": "edge_function",
      "aiChatEndpoint": "https://jsmcduecuxtaqizhmiqo.supabase.co/functions/v1/chat-assistant",
      "aiChatEndpointBearerToken": "",
      "aiChatEndpointAuthToken": "",
      "aiChatAllowDirectFallback": false,
      "aiChatAllowClientDirectInProduction": false,
      "openaiModel": "gpt-4o-mini",
      "mixpanelToken": "93ccc1f355ea98a1b4a34565320f6a83",
      "mixpanelSessionReplayEnabled": false,
      "mixpanelSessionReplayRecordingPercent": 25,
      "mixpanelSessionReplayWifiOnly": false,
      "mixpanelSessionReplayAutoStart": true,
      "mixpanelSessionReplayFlushIntervalSec": 10,
      "mixpanelSessionReplayEnableLogging": false,
      "remoteLogEnabled": false,
      "remoteLogUrl": "",
      "remoteLogMinLevel": "info"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-av",
      "expo-web-browser",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "assets/rhood_logo.png",
          "color": "#ffffff",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "R/HOOD uses your location while the app is open to match you with DJs and opportunities in the same city."
        }
      ],
      "expo-apple-authentication",
      "./plugins/withFirebaseModularHeaders",
      "@react-native-firebase/app",
      "expo-asset",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "scheme": "rhoodapp",
    "owner": "elokaagu",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/499f2244-43f3-478d-8b88-85c2da9f1d52"
    }
  }
}
